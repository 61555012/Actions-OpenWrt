# =========================================================
# S20P (chasey-dev/immortalwrt-mt798x-rebase 25.12)
# 目标: mediatek / filogic / 设备 clx_s20p
# 注意: 必须同时给出 TARGET_BOARD / TARGET_SUBTARGET 字符串,
#       否则 make defconfig 会回落到 filogic 默认设备(openwrt_one)
# =========================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_TARGET_mediatek_filogic_DEVICE_clx_s20p=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_clx_s20p=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y

# ---- LuCI ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ---- 常用工具 ----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ca-certificates=y

# ---- 网络增强(透明代理) ----
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y

# ---- mosdns (golang feed 已替换为 26.x) ----
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_mosdns=y
CONFIG_PACKAGE_v2ray-geodata=y

# ---- OpenAppFilter (已重拉 destan19 最新版) ----
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_OpenAppFilter=y
