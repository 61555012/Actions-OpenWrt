#!/bin/sh /etc/rc.common
# client-rates: 硬件加速(HNAT/PPE)下的逐设备流量采样服务
USE_PROCD=1
START=99
STOP=05

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/sbin/cr-sampler.uc
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
